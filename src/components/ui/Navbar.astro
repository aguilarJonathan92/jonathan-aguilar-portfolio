---
const links = [
  { label: "Inicio", href: "#inicio" },
  { label: "Sobre mí", href: "#sobre-mi" },
  { label: "Herramientas", href: "#herramientas" },
  { label: "Proyectos", href: "#proyectos" },
  { label: "Formación", href: "#formacion" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="navbar">
  <div class="navbar__inner">
    <a href="#inicio" class="navbar__logo">
      Jonathan<span> Aguilar</span>
    </a>

    <!-- Desktop -->
    <nav class="navbar__links" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a href={link.href} class="navbar__link">
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Hamburger mobile -->
    <button
      class="navbar__burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="navbar__mobile" aria-label="Menú móvil" hidden>
    {
      links.map((link) => (
        <a href={link.href} class="navbar__mobile-link">
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
  }

  .navbar__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar__logo {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .navbar__logo span {
    color: var(--color-accent);
  }

  .navbar__links {
    display: flex;
    gap: 28px;
  }

  .navbar__link {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .navbar__link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Burger — oculto en desktop */
  .navbar__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .navbar__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text-heading);
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  /* Estilo cuando el usuario está parado en esta sección */
  .navbar__link--active {
    color: var(--color-accent);
    font-weight: 600; /* Le damos un poquito más de grosor para que resalte */
    position: relative;
  }

  /* Opcional: Una rayita sutil violeta abajo del link activo (estilo muy moderno) */
  .navbar__link--active::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 2px;
  }

  /* Mobile menu */
  .navbar__mobile {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
    padding: 12px 40px 16px;
    background-color: var(--color-bg);
  }

  .navbar__mobile[hidden] {
    display: none;
  }

  .navbar__mobile-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 10px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .navbar__mobile-link:last-child {
    border-bottom: none;
  }

  .navbar__mobile-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .navbar__links {
      display: none;
    }

    .navbar__burger {
      display: flex;
    }

    .navbar__inner {
      padding: 0 20px;
    }
  }

  @media (max-width: 480px) {
    .navbar__mobile {
      padding: 8px 20px 14px;
    }
  }
</style>

<script>
  // --- Tu lógica anterior del menú mobile ---
  const burger = document.querySelector(".navbar__burger") as HTMLButtonElement;
  const menu = document.getElementById("mobile-menu") as HTMLElement;

  burger?.addEventListener("click", () => {
    const isOpen = !menu.hidden;
    menu.hidden = isOpen;
    burger.setAttribute("aria-expanded", String(!isOpen));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.hidden = true;
      burger.setAttribute("aria-expanded", "false");
    });
  });

  // --- NUEVA LÓGICA: Scroll Spy con IntersectionObserver ---
  const sections = document.querySelectorAll("section[id]");
  const navLinks = document.querySelectorAll(".navbar__link");

  const callback = (entries: IntersectionObserverEntry[]) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute("id");

        // Removemos la clase activa de todos los links
        navLinks.forEach((link) =>
          link.classList.remove("navbar__link--active"),
        );

        // Se la agregamos solo al link que coincida con el ID de la sección visible
        const activeLink = document.querySelector(
          `.navbar__link[href="#${id}"]`,
        );
        if (activeLink) {
          activeLink.classList.add("navbar__link--active");
        }
      }
    });
  };

  // Configuramos el observador
  const observer = new IntersectionObserver(callback, {
    // rootMargin define una "línea de detección".
    // -20% desde arriba y -60% desde abajo asegura que detecte la sección que está en el centro de la pantalla
    rootMargin: "-20% 0px -60% 0px",
  });

  // Ponemos a observar cada una de tus secciones
  sections.forEach((section) => observer.observe(section));
</script>
