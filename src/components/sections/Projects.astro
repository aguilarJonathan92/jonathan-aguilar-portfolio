---
import { projects } from '../../data/projects';
import ProjectCard from '../ui/ProjectCard.astro';

const featured  = projects.filter(p => p.featured);
const secondary = projects.filter(p => !p.featured);
---

<section id="proyectos" class="projects alt">
  <div class="projects__inner">
    <div class="projects__header">
      <p class="sec-label">Proyectos</p>
      <h2 class="sec-heading">Lo que construí</h2>
    </div>

    <div class="projects__grid">
      <!-- Proyecto destacado: columna izquierda completa -->
      <div class="projects__featured">
        {featured.map(p => (
          <ProjectCard project={p} featured={true} />
        ))}
      </div>

      <!-- Proyectos secundarios: columna derecha apilada -->
      <div class="projects__secondary">
        {secondary.map(p => (
          <ProjectCard project={p} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .projects__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--section-padding);
  }

  .projects__header {
    margin-bottom: 32px;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    align-items: start;
  }

  .projects__featured {
    display: flex;
    flex-direction: column;
  }

  .projects__secondary {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .projects__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .projects__secondary {
      gap: 14px;
    }
  }
</style>