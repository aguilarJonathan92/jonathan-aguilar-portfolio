---
const education = [
  {
    title: "Licenciatura en Sistemas de Información",
    institution: "Universidad Nacional del Nordeste (UNNE) · Corrientes",
    period: "En curso",
    description: "Formación académica orientada al diseño y arquitectura de software. Enfoque en algoritmos, Estructuras de Datos, Paradigmas de Programación (POO, Funcional), Análisis de Sistemas y modelado de Bases de Datos relacionales.",
    accent: true,
  },
  {
    title: "Formación Autodidacta Avanzada",
    institution: "Desarrollo basado en proyectos reales",
    period: "En curso",
    description: "Especialización práctica en entornos backend profesionales. Actualmente aplicando Spring Boot y Laravel en el desarrollo de la 'Bitácora Armónica Digital' y el sistema de gestión de inventario para 'Cristal Librería', entregado de manera funcional a un cliente real.",
    accent: false,
  },
];
---

<section id="formacion" class="education">
  <div class="education__inner">
    <div class="education__header">
      <p class="sec-label">Formación</p>
      <h2 class="sec-heading">Educación y Trayectoria</h2>
    </div>

    <div class="education__list">
      {education.map(item => (
        <div class="edu-card">
          <div class:list={['edu-card__dot', { 'edu-card__dot--muted': !item.accent }]}></div>
          <div class="edu-card__body">
            <div class="edu-card__top">
              <h3 class="edu-card__title">{item.title}</h3>
              <span class="edu-card__period">{item.period}</span>
            </div>
            <p class="edu-card__institution">{item.institution}</p>
            <p class="edu-card__desc">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Modificado para ocupar el 100% de la pantalla y centrar verticalmente */
  .education {
    min-height: calc(100vh - 56px);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 40px 0;
    box-sizing: border-box;
  }

  .education__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .education__header {
    margin-bottom: 32px;
  }

  /* Subido el tamaño e igualado con el Sobre mí */
  .sec-label {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 10px;
  }

  .sec-heading {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .education__list {
    display: flex;
    flex-direction: column;
    gap: 24px; /* Un poco más de aire entre tarjetas */
    position: relative;
  }

  .edu-card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background-color: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px 28px; /* Más espaciado interno */
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .edu-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .edu-card__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 6px;
    box-shadow: 0 0 0 4px var(--color-accent-soft, rgba(127, 119, 221, 0.15));
  }

  .edu-card__dot--muted {
    background-color: var(--color-accent-light);
    box-shadow: none;
  }

  .edu-card__body {
    flex: 1;
  }

  .edu-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .edu-card__title {
    font-family: var(--font-display);
    font-size: 17px; /* Subido de 15px para mayor legibilidad */
    font-weight: 600;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  .edu-card__period {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent-mid, var(--color-accent));