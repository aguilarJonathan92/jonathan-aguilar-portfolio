---
const contacts = [
  {
    label: "GitHub",
    value: "github.com/aguilarJonathan92",
    href: "https://github.com/aguilarJonathan92",
    external: true,
    icon: "github",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/tu-perfil", // Recordá cambiar por tu url real
    href: "https://linkedin.com/in/tu-perfil",
    external: true,
    icon: "linkedin",
  },
];
---

<section id="contacto" class="contact">
  <div class="contact__inner">
    <div class="contact__header">
      <p class="sec-label">Contacto</p>
      <h2 class="sec-heading">Hablemos</h2>
      <p class="contact__sub">
        Estoy disponible para posiciones de backend, pasantías o proyectos en
        Argentina y LATAM.
      </p>
    </div>

    <div class="contact__layout">
      <form
        id="portfolio-form"
        action="https://formspree.io/f/mqeoyjro"
        method="POST"
        class="contact__form"
      >
        <div class="form-group">
          <label for="name" class="form-label">Nombre</label>
          <input
            type="text"
            name="name"
            id="name"
            required
            class="form-input"
            placeholder="Tu nombre"
          />
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Correo Electrónico</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="form-input"
            placeholder="tu@correo.com"
          />
        </div>

        <div class="form-group">
          <label for="message" class="form-label">Mensaje</label>
          <textarea
            name="message"
            id="message"
            rows="4"
            required
            class="form-input form-input--textarea"
            placeholder="¿En qué puedo ayudarte?"></textarea>
        </div>

        <button type="submit" class="form-btn" id="form-submit-btn">Enviar Mensaje</button>
        <div id="form-status" class="form-status" hidden></div>
      </form>

      <div class="contact__sidebar">
        <div id="secure-mail-card"></div>

        {
          contacts.map((c) => (
            <a
              href={c.href}
              class="contact-chip"
              target={c.external ? "_blank" : undefined}
              rel={c.external ? "noopener noreferrer" : undefined}
              aria-label={`${c.label}: ${c.value}`}
            >
              <span class="contact-chip__icon" aria-hidden="true">
                {c.icon === "github" && (
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                )}
                {c.icon === "linkedin" && (
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect x="2" y="9" width="4" height="12" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
              </span>
              <span class="contact-chip__body">
                <span class="contact-chip__label">{c.label}</span>
                <span class="contact-chip__value">{c.value}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // 1. Lógica anti-spam del correo (directa, sin DOMContentLoaded)
  const user = "tucorreo"; 
  const domain = "email.com";
  const fullEmail = `${user}@${domain}`;
  
  const container = document.getElementById('secure-mail-card');
  if (container) {
    container.innerHTML = `
      <a href="mailto:${fullEmail}" class="contact-chip" aria-label="Email: Enviar un correo">
        <span class="contact-chip__icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </span>
        <span class="contact-chip__body">
          <span class="contact-chip__label">Email</span>
          <span class="contact-chip__value">${fullEmail}</span>
        </span>
      </a>
    `;
  }

  // 2. Lógica del Formulario (directa)
  const form = document.getElementById('portfolio-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLDivElement;
  const btn = document.getElementById('form-submit-btn') as HTMLButtonElement;

  if (form && status && btn) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); // <-- Esto ES lo que frena la redirección
      
      btn.disabled = true;
      btn.innerText = "Enviando...";

      const data = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: data,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          status.className = "form-status form-status--success";
          status.innerText = "¡Gracias! Tu mensaje ha sido enviado con éxito.";
          status.hidden = false;
          form.reset();
        } else {
          const errorData = await response.json();
          throw new Error(errorData.error || "Ocurrió un error al enviar.");
        }
      } catch (error) {
        status.className = "form-status form-status--error";
        status.innerText = "Ups! Hubo un problema al enviar. Intentalo de nuevo.";
        status.hidden = false;
      } finally {
        btn.disabled = false;
        btn.innerText = "Enviar Mensaje";
      }
    });
  }
</script>

<style>
  .contact {
    min-height: calc(100vh - 56px - 7vh); 
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--color-bg);
    padding: 80px 0 60px 0; 
    box-sizing: border-box;
    border-top: none; /
  }

  .contact__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
    width: 100%;
  }

  .contact__header {
    text-align: center;
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sec-label {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 10px;
  }

  .sec-heading {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    color: var(--color-text-heading);
    letter-spacing: -0.02em;
  }

  .contact__sub {
    font-size: 15px;
    color: var(--color-text-soft);
    margin-top: 12px;
    max-width: 540px;
    line-height: 1.65;
  }

  .contact__layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }

  /* Formulario */
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    background-color: var(--color-bg-white);
    border: 1px solid var(--color-border);
    padding: 32px;
    border-radius: var(--radius-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .form-input {
    font-size: 14.5px;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    color: var(--color-text-heading);
    border-radius: var(--radius-md);
    outline: none;
    transition: border-color 0.15s ease;
  }

  .form-input:focus {
    border-color: var(--color-accent);
  }

  .form-input--textarea {
    resize: none;
  }

  .form-btn {
    font-size: 14px;
    font-weight: 600;
    padding: 14px;
    background-color: var(--color-accent);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .form-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Sidebar */
  .contact__sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
    max-width: 340px;
    margin: 0 auto;
    width: 100%;
  }

  /* Estilos para el mensaje de estado */
  .form-status {
    font-size: 13.5px;
    font-weight: 500;
    padding: 12px;
    border-radius: var(--radius-md, 6px);
    text-align: center;
    margin-top: 10px;
    animation: fadeIn 0.3s ease;
  }

  .form-status--success {
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .form-status--error {
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  /* Animación suave para la aparición del cartel */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Los estilos globales del contact-chip se inyectan acá para el script dinámico */
  :global(.contact-chip) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background-color: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  :global(.contact-chip:hover) {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(83, 74, 183, 0.06);
    text-decoration: none;
  }

  :global(.contact-chip__icon) {
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background-color: var(--color-accent-soft);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  :global(.contact-chip__body) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.contact-chip__label) {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  :global(.contact-chip__value) {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-heading);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .contact__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .contact__sidebar {
      max-width: 100%;
    }
  }

  @media (max-width: 600px) {
    .contact__inner {
      padding: 0 20px;
    }

    .contact__form {
      padding: 20px;
    }
  }
</style>
