---
const contacts = [
  {
    label: "Email",
    value: "tucorreo@email.com",
    href: "mailto:tucorreo@email.com",
    external: false,
    icon: "mail",
  },
  {
    label: "GitHub",
    value: "github.com/aguilarJonathan92",
    href: "https://github.com/aguilarJonathan92",
    external: true,
    icon: "github",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/tu-perfil",
    href: "https://linkedin.com/in/tu-perfil",
    external: true,
    icon: "linkedin",
  },
];
---

<section id="contacto" class="contact alt">
  <div class="contact__inner">
    <div class="contact__header">
      <p class="sec-label">Contacto</p>
      <h2 class="sec-heading">Hablemos</h2>
      <p class="contact__sub">
        Estoy disponible para posiciones de backend, pasantías o proyectos freelance
        en Argentina y LATAM.
      </p>
    </div>

    <div class="contact__chips">
      {contacts.map(c => (
        <a
          href={c.href}
          class="contact-chip"
          target={c.external ? "_blank" : undefined}
          rel={c.external ? "noopener noreferrer" : undefined}
          aria-label={`${c.label}: ${c.value}`}
        >
          <span class="contact-chip__icon" aria-hidden="true">
            {c.icon === "mail" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            )}
            {c.icon === "github" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            )}
            {c.icon === "linkedin" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            )}
          </span>
          <span class="contact-chip__body">
            <span class="contact-chip__label">{c.label}</span>
            <span class="contact-chip__value">{c.value}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-surface);
    border-bottom: none;
  }

  .contact__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--section-padding);
  }

  .contact__header {
    margin-bottom: 32px;
  }

  .contact__sub {
    font-size: 14px;
    color: var(--color-text-soft);
    margin-top: 10px;
    max-width: 480px;
    line-height: 1.65;
  }

  .contact__chips {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .contact-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    background-color: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .contact-chip:hover {
    border-color: var(--color-accent-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(83, 74, 183, 0.08);
    text-decoration: none;
  }

  .contact-chip__icon {
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background-color: var(--color-accent-soft);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .contact-chip__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .contact-chip__label {
    font-size: 10px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .contact-chip__value {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-heading);
  }

  @media (max-width: 600px) {
    .contact__chips {
      flex-direction: column;
    }

    .contact-chip {
      width: 100%;
    }
  }
</style>